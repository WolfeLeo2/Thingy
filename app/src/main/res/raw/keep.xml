<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings resolved by NAME at runtime, which R8's resource shrinker cannot trace. Without keeping
  them, shrinkResources strips them — release builds only, so debug looks fine:

  - default_web_client_id: MainActivity resolves it via Resources.getIdentifier(); stripping it
    makes serverClientId null and Google Sign-in breaks ("sign-in isn't configured" on the login page).
  - mapbox_access_token: generated by build.gradle.kts resValue and read by the Mapbox SDK itself at
    init — no Kotlin or XML reference exists anywhere for the shrinker to follow. Stripping it means
    the map has no token on release even though the CI secret was passed in correctly.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id,@string/mapbox_access_token" />
