rules_version = '2';
// Items and spaceItems are still owner-only (classification runs on-device, so the owner
// is the trusted classifier). Spaces are shared: access is via memberIds, not userId —
// see [[thingy-shared-spaces-wanted]] memory. spaceItems content-sharing across members
// is a follow-up (items collection would need its own visibility rework).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    // Every denormalized array below is read with data.get(field, []) rather than data.field. A doc
    // written before that field existed (legacy space / pre-visibleTo item) makes `uid in data.field`
    // an *evaluation error*, which Firestore reports as PERMISSION_DENIED — indistinguishable from a
    // real denial, and it rejects the whole query, not just the offending doc. Defaulting to [] makes
    // a missing field mean "not shared" instead of taking the request down.
    function isMember(spaceId) {
      let space = get(/databases/$(database)/documents/spaces/$(spaceId));
      return space != null && (
        space.data.get('userId', '') == request.auth.uid ||
        request.auth.uid in space.data.get('memberIds', [])
      );
    }
    function isOwner(spaceId) {
      let space = get(/databases/$(database)/documents/spaces/$(spaceId));
      return space != null && space.data.get('userId', '') == request.auth.uid;
    }

    match /items/{id} {
      // visibleTo is the denormalized union of memberIds across every shared space the item is in
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('visibleTo', []));
      allow create: if ownsIncoming();
      // owner can edit anything; anyone who can already see the item (or is granting/removing
      // *themself*, e.g. joining/leaving a shared space) may touch visibleTo and nothing else
      allow update: if (ownsExisting() && ownsIncoming()) || (
        signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibleTo']) && (
          request.auth.uid in resource.data.get('visibleTo', []) ||
          request.auth.uid in request.resource.data.get('visibleTo', [])
        )
      );
      allow delete: if ownsExisting();
    }

    match /spaces/{id} {
      // owner fallback covers pre-sharing docs that haven't been backfilled with memberIds yet
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if signedIn() && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.userId == request.auth.uid;
      // owner can edit freely; a non-owner may edit while remaining a member, or add/remove *themself* (join/leave)
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.uid in resource.data.get('memberIds', []) && request.auth.uid in request.resource.data.get('memberIds', [])) ||
        (!(request.auth.uid in resource.data.get('memberIds', [])) && request.auth.uid in request.resource.data.get('memberIds', [])
          && request.resource.data.get('memberIds', []).size() == resource.data.get('memberIds', []).size() + 1) ||
        (request.auth.uid in resource.data.get('memberIds', []) && !(request.auth.uid in request.resource.data.get('memberIds', []))
          && request.resource.data.get('memberIds', []).size() == resource.data.get('memberIds', []).size() - 1)
      );
      allow delete: if ownsExisting();
    }

    match /spaceMembers/{id} {
      allow read: if signedIn() && isMember(resource.data.spaceId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && isMember(request.resource.data.spaceId);
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isOwner(resource.data.spaceId));
    }

    match /invites/{code} {
      allow read: if signedIn();
      // any member can mint an invite (the Invite action lives in every member's menu), not just the owner
      allow create: if signedIn() && isMember(request.resource.data.spaceId);
      allow delete: if signedIn() && isMember(resource.data.spaceId);
    }

    match /spaceItems/{id} {
      // shared content: any current member of the space may read/write its rows, not just the adder.
      // ownsExisting() fallback covers the userId-only global memberships() listen (LibraryViewModel),
      // which has no spaceId in its query so isMember() alone can't authorize it.
      allow read: if signedIn() && (isMember(resource.data.spaceId) || ownsExisting());
      allow create: if signedIn() && isMember(request.resource.data.spaceId) && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && isMember(resource.data.spaceId) && isMember(request.resource.data.spaceId);
      allow delete: if signedIn() && isMember(resource.data.spaceId);
    }

    match /spaceComments/{id} {
      // Comments are always queried scoped to one space, so isMember() can authorize them directly
      // and they need no denormalized visibility array — unlike items, which are queried globally by
      // userId and therefore carry visibleTo. A new member consequently sees the whole thread with
      // no backfill, and there's no missing-field trap to fall into.
      //
      // The author clause is NOT redundant, and it is first so it short-circuits the get(): comments
      // deliberately outlive their author leaving the space, so the export's
      // `where userId == uid` sweep would match docs in spaces the user is no longer a member of.
      // A query is denied wholesale when any matched doc fails, so without this one departed space
      // silently emptied the entire comments section of the data export.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isMember(resource.data.spaceId)
      );
      allow create: if signedIn() && isMember(request.resource.data.spaceId)
        && request.resource.data.userId == request.auth.uid
        // Bound the text server-side: nothing else stops a member posting a megabyte, and the sheet
        // would render it.
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        // Pin the timestamp to the server's clock — the @ServerTimestamp sentinel satisfies this.
        // A client-chosen far-future createdAt would become the newest comment, and since the unread
        // cursor is stamped from it and never moves backwards, every genuine comment after it would
        // be born already-read with no way back.
        && request.resource.data.createdAt == request.time;
      // Text is immutable: an edited comment in a shared thread rewrites what others already read.
      allow update: if false;
      // Author OR space owner. The owner half matters because comments outlive their author leaving
      // the space — someone has to be able to tidy up afterwards. Note isOwner() reads the space
      // doc, so deleting a comment in a space that has since been deleted falls back to the author
      // check, which is what lets a departed member still remove their own.
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid || isOwner(resource.data.spaceId)
      );
    }

    // Self-service account deletion marker: doc id == uid, so "own this row" is just an id check.
    // The nightly purge workflow (tools/account-purge) reads/writes these with the Admin SDK,
    // which bypasses rules entirely — these rules only govern the client.
    match /accountDeletions/{uid} {
      allow read, create, delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
